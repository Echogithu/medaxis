  "chief_complaint": "这两天办公后头痛，太阳穴两边发紧，休息后会好一些。最近睡得比较晚。想知道就医时该怎么讲清楚。",
  "interview": {
    "session_id": "readme-headache-session",
    "opening": "我先帮你把症状说清楚。还需要确认两点，方便医生了解情况。",
    "questions": [
      {
        "question_id": "severity",
        "question": "这次头痛有多影响你做事？",
        "type": "choice",
        "options": [
          "轻微，能照常做事",
          "影响做事，需要停下来",
          "非常难受",
          "不确定"
        ],
        "colloquial_phase": "症状情况",
        "reason": "了解这次不适对日常活动的影响。"
      },
      {
        "question_id": "associated",
        "question": "有没有发热、呕吐，或视力和说话的变化？",
        "type": "choice",
        "options": [
          "没有这些情况",
          "有发热或呕吐",
          "有视力或说话变化",
          "不确定"
        ],
        "colloquial_phase": "还要确认的情况",
        "reason": "保留本人对伴随情况的描述。"
      }
    ],
    "answers": [
      "轻微，能照常做事",
      "没有这些情况"
    ]
  },
  "report": {
    "primary_diagnosis": "可能与紧张性头痛有关，还需要医生确认。[S1]",
    "confidence": "low",
    "severity": "mild",
    "referral_needed": false,
    "key_findings": [
      "头痛断断续续 2 天，主要在两侧太阳穴，像被箍着。",
      "程度轻微，能够照常工作；休息后会缓解。",
      "本人表示没有发热、呕吐或视力和说话变化。"
    ],
    "recommended_actions": [
      "记录出现时间、持续多久以及伴随变化，带给医生看。[S2]",
      "整理近期睡眠和既往用药情况，方便就医时核对。",
      "若反复出现或逐渐加重，请及时就诊。[S2]"
    ],
    "recommended_tests": [
      "是否需要检查，请由接诊医生结合面诊判断。"
    ],
    "red_flags": [
      "如果头痛突然特别剧烈，或出现说话困难、肢体无力、视力下降，请立即寻求急诊帮助。[S2]"
    ],
    "contraindications": [
      "不要把这份总结当作确诊或处方；具体用药需与医生或药师核对。"
    ],
    "follow_up_timeline": "继续记录变化；若持续不缓解或加重，及时就诊。",
